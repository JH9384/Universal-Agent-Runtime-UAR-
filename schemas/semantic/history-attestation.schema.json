{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uar.dev/schemas/semantic/history-attestation.schema.json",
  "title": "UAR Semantic History Attestation",
  "type": "object",
  "required": ["manifest", "signature"],
  "properties": {
    "signature": {"type": "string", "minLength": 1},
    "manifest": {
      "type": "object",
      "required": ["schema", "key_id", "corpus_schema", "source_snapshot", "code_revision", "capture_window", "review_policy_sha256", "corpus_sha256", "run_count", "census"],
      "properties": {
        "schema": {"const": "uar.semantic-history-attestation.v1"},
        "key_id": {"type": "string", "minLength": 1},
        "corpus_schema": {"const": "uar.semantic-history-corpus.v1"},
        "source_snapshot": {"type": "string", "minLength": 1},
        "code_revision": {"type": "string", "minLength": 1},
        "capture_window": {"type": "object"},
        "review_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "run_count": {"type": "integer", "minimum": 1},
        "census": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      }
    }
  },
  "additionalProperties": false
}
